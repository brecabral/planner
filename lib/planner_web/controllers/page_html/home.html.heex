<Layouts.app flash={@flash}>
  <section class="mx-auto max-w-2xl py-16 sm:py-28">
    <p class="mb-5 text-sm font-semibold uppercase tracking-widest text-primary">
      {gettext("One day at a time")}
    </p>
    <h1 class="text-5xl font-semibold tracking-tight sm:text-7xl">
      {gettext("Space for what matters.")}
    </h1>
    <p class="mt-6 max-w-lg text-lg leading-relaxed text-base-content/70">
      {gettext("Choose three priorities. Take the next step. Leave the rest for later.")}
    </p>
    <.link id="open-planner" navigate={~p"/tasks"} class="btn btn-primary mt-10">
      {gettext("Open Just Three")} <.icon name="hero-arrow-right" class="size-5" />
    </.link>
  </section>
</Layouts.app>
